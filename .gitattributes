* text=auto
.gitattributes text eol=lf
*.py text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Sequence/profile data — always text, force LF for cross-platform consistency
*.fasta text eol=lf
*.fas text eol=lf
*.fna text eol=lf
*.tab text eol=lf
*.tsv text eol=lf
*.csv text eol=lf

# Binary reference databases — never let autocrlf touch these
*.pkl binary
*.xlsx binary
*.k2d binary
*.k2c binary
